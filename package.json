{
  "name": "coii",
  "version": "0.1.0",
  "private": true,
  "description": "coii: connect on ideas and interests. A live cartoon venue of topic booths and tiny humans, built for Devcon 8.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "node scripts/test-db.mjs",
    "test:functions": "deno test --allow-env --config supabase/functions/deno.json supabase/functions",
    "sync:shared": "node scripts/sync-shared.ts",
    "db:seed": "deno run --allow-read --allow-write=supabase/seed.sql --config scripts/deno.json scripts/seed.ts",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@fontsource/baloo-2": "5.3.0",
    "@fontsource/mukta": "5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "pixi.js": "8.21.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web": "0.0.357",
    "@vitejs/plugin-react": "6.1.1",
    "fast-check": "4.10.2",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.29.3"
}
